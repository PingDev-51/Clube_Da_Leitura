@using ClubeDaLeituraWeb.WebApp.ModuloRevistas.Apresentacao
@{
    Layout = "_Layout";
    ViewBag.title = "Devoclução de Revistas";

    List<ListarAmigosViewModel> amigos = ViewBag.Amigos;
    List<ListarRevistasViewModel> revistas = ViewBag.Revista;
}

<form class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;" method="post">

    <div class="mb-3">
        <label class="form-label fw-semibold text-primary text-uppercase small">
            Revista que deseja devolver
        </label>

        <select class="form-select" aria-label="Default select example">
            <option value="">Selecione a revista</option>

            @foreach (ListarRevistasViewModel r in revistas)
            {
                <option value="@r.Id">@r.Titulo</option>
            }
        </select>
    </div>

    <div class=" mb-3">
        <label class="form-label fw-semibold text-primary text-uppercase small">
            Quem irá devolver?
        </label>

        <select lass="form-select" aria-label="Default select example">
            <option value="">Selecione aqui.</option>

            @foreach (ListarAmigosViewModel a in amigos)
            {
                <option value="@a.Id">@a.Nome</option>
            }
        </select>
    </div>

    <div class="mb-3">
        <label class="form-label fw-semibold text-primary text-uppercase small">
            Data de devolução
        </label>

        <input type="date" class="form-control">
    </div>

    <div class="d-flex justify-content-end gap-2 mt-4">
        <a class="btn btn-outline-primary rounded-pill px-4" asp-action="Listar">
            Voltar
        </a>

        <button class="btn btn-primary rounded-pill px-4" type="submit">
            Confirmar
        </button>
    </div>
</form>