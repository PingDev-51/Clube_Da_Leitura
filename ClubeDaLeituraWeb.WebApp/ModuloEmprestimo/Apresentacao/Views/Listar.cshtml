@{
    Layout = "_Layout";
    ViewBag.title = "Lista de Emprestimo";

}

@model List<ListarEmprestimosViewModel>;

<a asp-action="Cadastrar">Cadastrar Novo</a>

@if (Model.Count == 0)
{
    <div>
        Nenhum Amigo foi encontrado.
    </div>
}
else
{
    <div>
        <table>
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Nome da Revista</th>
                    <th>Nome do Amigo</th>
                    <th>Data de Abertura</th>
                    <th>Data de Conclusão Precista</th>
                </tr>
            </thead>

            <tbody>
                @foreach (ListarEmprestimosViewModel e in Model)
                {
                    <tr>
                        <td>@e.Id</td>
                        <td>@e.Revista</td>
                        <td>@e.Amigo</td>
                        <td>@e.dataAbertura</td>
                        <td>@e.DataConclusaoPrevista</td>
                        <td>
                            <div>
                                <a asp-action="Editar" asp-route-id="@e.Id">Editar</a>
                                <a asp-action="Excluir" asp-route-id="@e.Id">>Excluir</a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}