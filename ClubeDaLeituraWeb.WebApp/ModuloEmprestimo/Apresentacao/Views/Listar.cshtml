@{
    Layout = "_Layout";
    ViewBag.title = "Lista de Empréstimos";
}

@model List<ListarEmprestimosViewModel>;

<a class="btn btn-outline-primary rounded-pill px-4 mb-3" asp-action="Cadastrar">
    Cadastrar Novo
</a>

@if (Model.Count == 0)
{
    <div class="alert alert-primary border-start border-primary border-2 rounded-3" role="alert">
        Nenhum empréstimo foi encontrado.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover table-bordered align-middle bg-white">

            <thead class="table-primary">
                <tr>
                    <th>ID</th>
                    <th>Nome da Revista</th>
                    <th>Nome do Amigo</th>
                    <th>Data de Abertura</th>
                    <th>Data de Conclusão Prevista</th>
                    <th>Ações</th>
                </tr>
            </thead>

            <tbody>
                @foreach (ListarEmprestimosViewModel e in Model)
                {
                    <tr>
                        <td>@e.Id</td>
                        <td>@e.Revista</td>
                        <td>@e.Amigo</td>
                        <td>@e.DataConclusaoPrevista</td>
                        <td>@e.DataAbertura.ToString(format: "dd/MM/yyyy")</td>
                        <td>@e.StatusEmprestimo</td>

                        <td>
                            <div class="d-flex gap-2">
                                <a class="btn btn-outline-primary btn-sm rounded-pill px-3" asp-action="CadastrarDevolucao"
                                   asp-route-id="@e.Id">
                                    Status Emprestimo
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
}