@{
    Layout = "_Layout";
    ViewBag.title = "Exclusão de Amigos";
}

@model ExcluirAmigosViewModel;

<div class="alert alert-danger" role="alert ">Deseja realmente excluir este Contato?</div>

<form asp-action="Excluir" asp-route-id="@Model.Id" method="post"
      class="card border-primary-subtle shadow-sm mx-auto p-4" style="max-width: 620px;">
    <div>
        <label asp-for="Nome" class="form-label fw-semibold text-primary text-uppercase small">Nome</label>
        <input asp-for="Nome" type="text" class="form-control" disabled>
        <span asp-validation-for="Nome" class="text-danger small fw-semibold"></span>
    </div>

    <div>
        <label asp-for="NomeResponsavel" class="form-label fw-semibold text-primary text-uppercase small">Nome do
            Responsavel</label>
            <input asp-for="NomeResponsavel" type="text" class="form-control" disabled>
            <span asp-validation-for=" NomeResponsavel" class="text-danger small fw-semibold"></span>
        </div>

        <div>
            <label asp-for="Telefone" class="form-label fw-semibold text-primary text-uppercase small">Telefone</label>
            <input asp-for="Telefone" type="tel" class="form-control" disabled>
            <span asp-validation-for=" Telefone" class="text-danger small fw-semibold"></span>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-4">
            <a asp-action="Listar" class="btn btn-outline-primary rounded-pill px-4">Voltar</a>
            <button type="submit" class="btn btn-primary rounded-pill px-4">Confirmar</button>
        </div>
    </form>